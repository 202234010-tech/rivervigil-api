          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response body conforms to BookResource structure\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('data');",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data.title).to.eql(\"Refactoring\");",
              "    pm.expect(jsonData.data.isbn).to.eql(\"9780134757599\");",
              "    pm.expect(jsonData.data.available).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('created_at');",
              "    pm.collectionVariables.set(\"book_id\", jsonData.data.id);",
              "});"
            ],
            "type": "text/javascript"
