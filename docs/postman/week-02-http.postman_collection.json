  "item": [
    {
      "name": "01 Request Anatomy",
      "item": [
        {
          "name": "GET Echo Query Parameters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{echo_base_url}}/get?search=laravel api&page=2",
              "host": [
                "{{echo_base_url}}"
              ],
              "path": [
                "get"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "laravel api",
                  "description": "Query parameter pencarian"
                },
                {
                  "key": "page",
                  "value": "2",
                  "description": "Nomor halaman"
                }
              ]
            },
            "description": "Request GET untuk mengeksplorasi penerimaan Query Parameters pada endpoint Echo API."
          },
          "response": []
        },
        {
          "name": "GET Echo Custom Header",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Custom header was received\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.headers[\"x-student-client\"]).to.eql(\"postman-week-2\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Student-Client",
                "value": "postman-week-2",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{echo_base_url}}/get?search=laravel api&page=2",
              "host": [
                "{{echo_base_url}}"
              ],
              "path": [
                "get"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "laravel api"
                },
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            },
            "description": "Request GET dengan custom header Accept dan X-Student-Client beserta post-response script untuk pengujian otomatis."
          },
          "response": []
        }
      ],
      "description": "Folder berisi request untuk mempelajari anatomi HTTP request: query parameters dan custom headers."
    },
