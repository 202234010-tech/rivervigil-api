        },
        {
          "name": "POST Telemetry - Validation Error (422 Unprocessable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Content\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Errors array specifies invalid fields\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"error\");",
                  "    pm.expect(json.errors.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
