        {
          "name": "POST Telemetry - Malformed JSON (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Error indicates malformed JSON\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"error\");",
                  "    pm.expect(json.errors[0].field).to.eql(\"payload\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
