    {
      "name": "02 Resource Telemetry",
      "item": [
        {
          "name": "POST Telemetry - Success (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Telemetry ID generated and alert calculated\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.telemetry_id).to.include(\"TLM-\");",
                  "    pm.expect(json.data.calculated_alert).to.be.oneOf([\"normal\", \"siaga_3\", \"siaga_2\", \"siaga_1\"]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"station_id\": \"STA-KATULAMPA\",\n  \"water_level_cm\": 145.5,\n  \"flow_rate_m3s\": 68.4,\n  \"rainfall_intensity_mmh\": 32.0,\n  \"recorded_at\": \"2026-09-25T11:00:00+07:00\"\n}"
            },
