{
  "info": {
    "_postman_id": "8a1c2d3e-4f5b-6a7c-8d9e-0123456789ab",
    "name": "Praktikum 3 — Merancang API Contract (RiverVigil API)",
    "description": "Postman Collection resmi untuk Praktikum 3 — Merancang API Contract pada mata kuliah Manajemen Layanan Web.\n\nMenguji:\n1. Pemetaan Kebutuhan menjadi Resource REST (Stations, Telemetry, Alerts, Shelters, Reports)\n2. Verifikasi HTTP Method & Semantik Status Codes (200, 201, 400, 404, 422)\n3. Standarisasi Envelope Response JSON (status, message, data, errors, meta)\n4. Kepatuhan Zero-Credential & Keamanan Sistem",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Resource Stations",
      "item": [
        {
          "name": "GET All Stations with Query Params (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has success envelope\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    pm.expect(json.meta).to.be.an(\"object\");",
                  "});",
                  "pm.test(\"Filtering by river_basin is applied\", function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function(st) {",
                  "        pm.expect(st.river_basin).to.eql(\"ciliwung\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stations?river_basin=ciliwung&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stations"],
              "query": [
                {
                  "key": "river_basin",
                  "value": "ciliwung"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "POST Register New Station (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Station data created with ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json.data.id).to.eql(\"STA-BEKASI-TEST\");",
                  "    pm.expect(json.data.thresholds_cm).to.be.an(\"object\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"STA-BEKASI-TEST\",\n  \"name\": \"Pos Pantau Kali Bekasi Hilir\",\n  \"river_basin\": \"bekasi\",\n  \"location\": \"Kota Bekasi, Jawa Barat\",\n  \"current_level_cm\": 95.0,\n  \"flow_rate_m3s\": 34.0,\n  \"thresholds_cm\": {\n    \"normal\": 100,\n    \"siaga_3\": 200,\n    \"siaga_2\": 300,\n    \"siaga_1\": 400\n  }\n}"
            },
            "url": {
