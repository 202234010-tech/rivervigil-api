      "name": "01 Stations",
      "item": [
        {
          "name": "GET All Stations with Query Params",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is valid JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Response envelope status is success\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Query parameter filtering is respected\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.meta.page).to.eql(1);",
                  "    jsonData.data.forEach(function(station) {",
                  "        pm.expect(station.river_basin).to.eql(\"ciliwung\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stations?river_basin=ciliwung&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stations"],
              "query": [
                {
                  "key": "river_basin",
                  "value": "ciliwung"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
