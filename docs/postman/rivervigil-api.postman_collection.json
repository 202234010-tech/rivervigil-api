            "url": {
              "raw": "{{base_url}}/api/v1/alerts/active",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "alerts",
                "active"
              ]
            },
            "description": "Mengambil seluruh peringatan dini aktif (Siaga 1 - Siaga 3)."
          },
