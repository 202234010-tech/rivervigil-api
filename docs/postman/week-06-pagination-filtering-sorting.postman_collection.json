      "name": "01 - Tugas 6: Stations API (Resource Utama Project Semester)",
      "description": "Pengujian endpoint collection /api/v1/stations untuk proyek semester RiverVigil API.",
      "item": [
        {
          "name": "01 - Default Pagination (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success envelope and pagination metadata\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json).to.have.property(\"data\");",
                  "    pm.expect(json).to.have.property(\"links\");",
                  "    pm.expect(json).to.have.property(\"meta\");",
                  "    pm.expect(json.meta.current_page).to.eql(1);",
                  "    pm.expect(json.meta.per_page).to.eql(10);",
                  "    pm.expect(json.meta.total).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations"
              ]
            }
          }
        },
