{
  "info": {
    "_postman_id": "a91b2c3d-4e5f-6a7b-8c9d-0e1f2a3b4c5d",
    "name": "Praktikum & Tugas 6 — Pagination, Filtering, and Sorting (RiverVigil API)",
    "description": "Postman Collection resmi untuk Tugas 6 — Endpoint Collection yang Dapat Dicari pada mata kuliah Manajemen Layanan Web.\n\nMenguji Resource Utama Project Semester (Station) dan Resource Pendukung (Book):\n1. Default pagination\n2. Custom page dan per_page\n3. Search pada minimal dua field (name dan location)\n4. Sorting ascending dan descending dengan allowlist\n5. Kombinasi pagination + search + sorting (dengan preservasi query string pada links)\n6. Query validation yang menghasilkan 422 Unprocessable Content untuk input invalid",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Default Pagination (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success envelope and pagination metadata\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.eql(\"success\");",
              "    pm.expect(json).to.have.property(\"data\");",
              "    pm.expect(json).to.have.property(\"links\");",
              "    pm.expect(json).to.have.property(\"meta\");",
              "    pm.expect(json.meta.current_page).to.eql(1);",
              "    pm.expect(json.meta.total).to.be.at.least(1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/stations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "stations"
          ]
        }
      }
    },
    {
      "name": "02 - Custom Pagination Page 1 (per_page=2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Page 1 contains at most 2 items and valid next link\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.length).to.be.at.most(2);",
              "    pm.expect(json.meta.current_page).to.eql(1);",
              "    pm.expect(json.meta.per_page).to.eql(2);",
              "    pm.expect(json.links.next).to.not.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/stations?per_page=2&page=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "stations"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "2"
            },
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      }
    },
