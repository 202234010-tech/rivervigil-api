    {
      "name": "10 - Invalid Sort Allowlist (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 422 Unprocessable Content\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "",
              "pm.test(\"Error response matches standard error envelope\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.status).to.eql(\"error\");",
              "    pm.expect(json).to.have.property(\"errors\");",
              "    var hasSortError = json.errors.some(function(err) { return err.field === 'sort'; });",
              "    pm.expect(hasSortError).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/stations?sort=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "stations"
          ],
          "query": [
            {
              "key": "sort",
              "value": "password"
