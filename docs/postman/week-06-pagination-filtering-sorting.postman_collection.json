    {
      "name": "09 - Combined Pagination + Search + Sorting",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Pagination links retain all query parameters\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.links.first).to.include('search=Pos');",
              "    pm.expect(json.links.first).to.include('sort=name');",
              "    pm.expect(json.links.first).to.include('direction=asc');",
              "    pm.expect(json.links.first).to.include('per_page=2');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
