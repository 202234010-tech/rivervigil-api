    {
      "name": "07 - Sorting Ascending by Name",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Results sorted ascending A-Z by name\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.data.length).to.be.above(1);",
              "    for (var i = 0; i < json.data.length - 1; i++) {",
              "        pm.expect(json.data[i].name.localeCompare(json.data[i+1].name)).to.be.at.most(0);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/stations?sort=name&direction=asc&per_page=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "stations"
          ],
          "query": [
            {
              "key": "sort",
              "value": "name"
            },
            {
              "key": "direction",
              "value": "asc"
            },
            {
              "key": "per_page",
              "value": "10"
            }
          ]
        }
